# Optional. Set it and the server pays for every translation; leave it empty and the
# translate form asks each visitor for their own OpenAI key instead.
OPENAI_API_KEY=
# Optional: the "Look up" button already fills in movie/show context from Wikipedia; a TMDB key adds
# character genders and fills gaps. Either a v3 API key or a v4 read access token works.
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# The public address of your deployment, such as https://example.com. Used for canonical URLs, the
# sitemap, and the User-Agent sent to Wikipedia. Read at build time. On Vercel it defaults to the
# project's production domain; elsewhere to http://localhost:3000.
SITE_URL=
# Optional: the Google Search Console verification token for your site.
GOOGLE_SITE_VERIFICATION=
